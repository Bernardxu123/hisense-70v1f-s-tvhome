<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.local.tvhome"
    android:versionCode="12"
    android:versionName="1.8">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 强制停止聚好看：signature|privileged 权限，装在 /system/priv-app 才拿得到 -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="TvHome"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 独立 filter：让 TvHome 成为合法桌面候选；priority 用于盖过聚好看的 50 -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 不再做「开机自动抢前台」：用户要求开机停在聚好看，手动进入 TvHome 时再清理。
             清理动作在 MainActivity.onResume 里完成（见 StockCleaner）。

             下面这个接收器只用于调试：不切换界面，只在后台跑一次清理，便于用 adb 验证权限。
             不想保留可以整段删掉，不影响 TvHome 正常使用。 -->
        <!-- 开机后切一次到自己（只在前 10 秒尝试，切到就停） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".DebugReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.local.tvhome.DEBUG_KILL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>









